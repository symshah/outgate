<!--
  Midnight theme (SPEC-UI §0 themes / user palette).
  Overrides the WPF-UI resource keys the app already uses, plus the app's own keys,
  so switching dictionaries live re-skins every page without touching page XAML.
  Window background: vertical gradient #0B1322 -> #101B2E; border #22314D; corner radius 20.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== window / chrome ===== -->
    <LinearGradientBrush x:Key="ApplicationBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0B1322" Offset="0"/>
        <GradientStop Color="#101B2E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppWindowBorderBrush" Color="#22314D"/>
    <LinearGradientBrush x:Key="AppWindowBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0B1322" Offset="0"/>
        <GradientStop Color="#101B2E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#0E1729"/>
    <SolidColorBrush x:Key="AppTitleBarBackgroundBrush" Color="#00000000"/>

    <!-- ===== cards, glass fill ~6-10% white, 1px 10% white border ===== -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#0E1729"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#13203A"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0FFFFFFF"/>

    <!-- ===== text ===== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E8EEF7"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#8A97AD"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6D7A90"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5A6579"/>

    <!-- ===== accent + status ===== -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5B95F8"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF"/>

    <!-- ===== app keys (rows, chips, toggles, status colours) ===== -->
    <SolidColorBrush x:Key="AppRowHoverBrush" Color="#1A2740"/>
    <SolidColorBrush x:Key="AppRowSelectedBrush" Color="#1A2740"/>
    <SolidColorBrush x:Key="AppRowDividerBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#1E2B44"/>
    <SolidColorBrush x:Key="AppChipTextBrush" Color="#A9B4C8"/>
    <SolidColorBrush x:Key="AppToggleTrackBrush" Color="#1E2A40"/>
    <SolidColorBrush x:Key="AppGreenBrush" Color="#2FBF5B"/>
    <SolidColorBrush x:Key="AppRedBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="AppOrangeBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="AppBlueBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AppSearchBackgroundBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="AppSearchBorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="AppIconTileBrush" Color="#FFFFFFFF"/>

    <!-- ===== semantic keys (same key set as Aurora) ===== -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#5B95F8"/>
    <SolidColorBrush x:Key="AppAllowedBrush" Color="#2FBF5B"/>
    <SolidColorBrush x:Key="AppBlockedBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="AppAskingBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="AppReceivedBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="AppSentBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="AppAIBrush" Color="#A855F7"/>
    <SolidColorBrush x:Key="AppAllowedTintBrush" Color="#262FBF5B"/>
    <SolidColorBrush x:Key="AppBlockedTintBrush" Color="#26E5484D"/>
    <SolidColorBrush x:Key="AppAskingTintBrush" Color="#26F5A524"/>
    <SolidColorBrush x:Key="AppAccentTintBrush" Color="#263B82F6"/>
    <SolidColorBrush x:Key="AppOnAllowedBrush" Color="#0D2A1F"/>
    <SolidColorBrush x:Key="AppOnBlockedBrush" Color="#3A0E18"/>
    <SolidColorBrush x:Key="AppSidebarSelectedBrush" Color="#2E3B82F6"/>
    <Color x:Key="AppGlowVioletColor">#00000000</Color>
    <Color x:Key="AppGlowVioletMidColor">#00000000</Color>
    <Color x:Key="AppGlowTealMidColor">#00000000</Color>
    <Color x:Key="AppGlowTealColor">#00000000</Color>

    <!-- ===== SPEC-GLASS G2: glass card resources (same key set in all four themes) ===== -->
    <!-- Fill: 14% white fading to 6% (dark glass, over the navy gradient) -->
    <LinearGradientBrush x:Key="GlassFillGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Specular edge: 40% white at top-left fading to 5% at bottom-right -->
    <LinearGradientBrush x:Key="GlassEdgeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassTopHighlightBrush" Color="#40FFFFFF"/>
    <!-- G3: segmented-control track + "liquid" thumb (midnight) -->
    <SolidColorBrush x:Key="GlassSegTrackBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="GlassSegThumbBrush" Color="#59FFFFFF"/>
    <!-- G3: tinted glass buttons (primary / Allow-mint / Block-coral) + their icon+text colours -->
    <LinearGradientBrush x:Key="GlassPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4D3B82F6" Offset="0"/>
        <GradientStop Color="#2E3B82F6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassMintBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3334D399" Offset="0"/>
        <GradientStop Color="#1F34D399" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCoralBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33FB7185" Offset="0"/>
        <GradientStop Color="#1FFB7185" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassMintTextBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="GlassCoralTextBrush" Color="#FB7185"/>
    <!-- Cached blurred aurora snapshot: ImageSource is set once at startup (see
         MainWindow.CaptureGlassBackdrop). Empty in non-Aurora themes because the
         glow colours there are transparent. -->
    <ImageBrush x:Key="GlassAuroraBackdropBrush" Opacity="0.55" Stretch="Fill"/>
    <!-- Card-only shadow (rows/pills get none) -->
    <DropShadowEffect x:Key="GlassCardShadow" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.3" Color="#000000"/>
</ResourceDictionary>
