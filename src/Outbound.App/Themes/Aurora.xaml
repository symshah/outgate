<!--
  Aurora — the default theme: deep ink background with two soft glows (violet top-left, teal
  bottom-right), glass cards and a violet accent. Same key set as Light/Graphite/Midnight, so
  switching dictionaries live re-skins every page and window without touching page XAML.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== window / chrome ===== -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0D0F1A"/>
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#0D0F1A"/>
    <SolidColorBrush x:Key="AppWindowBorderBrush" Color="#262B42"/>
    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#CC11131F"/>   <!-- 80% so the glow shows through -->
    <SolidColorBrush x:Key="AppTitleBarBackgroundBrush" Color="#00000000"/>
    <Color x:Key="AppGlowVioletColor">#8B5CF6</Color>
    <Color x:Key="AppGlowVioletMidColor">#738B5CF6</Color>
    <Color x:Key="AppGlowTealMidColor">#7322D3EE</Color>
    <Color x:Key="AppGlowTealColor">#22D3EE</Color>

    <!-- ===== cards (85% opaque) and rows ===== -->
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#D9161A2B"/>      <!-- #161A2B at 85% -->
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#262B42"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#D9161A2B"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#B3161A2B"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#262B42"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1B1F33"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#161A2B"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#141728"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#11131F"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#161A2B"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#20243A"/>
    <SolidColorBrush x:Key="AppRowHoverBrush" Color="#1B1F33"/>
    <SolidColorBrush x:Key="AppRowSelectedBrush" Color="#1B1F33"/>
    <SolidColorBrush x:Key="AppRowDividerBrush" Color="#20243A"/>
    <SolidColorBrush x:Key="AppSidebarSelectedBrush" Color="#2E8B5CF6"/>     <!-- violet at 18% -->

    <!-- ===== text ===== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#ECEEF7"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#8B90A8"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6E7391"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#565B78"/>

    <!-- ===== accent + status ===== -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#9D74F7"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#9D74F7"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1B1F33"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#161A2B"/>

    <SolidColorBrush x:Key="AppAllowedBrush" Color="#34D399"/>    <!-- mint   -->
    <SolidColorBrush x:Key="AppBlockedBrush" Color="#FB7185"/>    <!-- coral  -->
    <SolidColorBrush x:Key="AppAskingBrush" Color="#FBBF24"/>     <!-- amber  -->
    <SolidColorBrush x:Key="AppReceivedBrush" Color="#22D3EE"/>   <!-- cyan   -->
    <SolidColorBrush x:Key="AppSentBrush" Color="#FB923C"/>       <!-- peach  -->
    <SolidColorBrush x:Key="AppAIBrush" Color="#C084FC"/>         <!-- AI     -->
    <!-- legacy key names still used by older XAML -->
    <SolidColorBrush x:Key="AppGreenBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="AppRedBrush" Color="#FB7185"/>
    <SolidColorBrush x:Key="AppOrangeBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="AppBlueBrush" Color="#8B5CF6"/>

    <!-- tinted backgrounds = colour at 15% -->
    <SolidColorBrush x:Key="AppAllowedTintBrush" Color="#2634D399"/>
    <SolidColorBrush x:Key="AppBlockedTintBrush" Color="#26FB7185"/>
    <SolidColorBrush x:Key="AppAskingTintBrush" Color="#26FBBF24"/>
    <SolidColorBrush x:Key="AppAccentTintBrush" Color="#268B5CF6"/>
    <SolidColorBrush x:Key="AppOnAllowedBrush" Color="#0D2A1F"/>  <!-- dark text inside a filled mint circle -->
    <SolidColorBrush x:Key="AppOnBlockedBrush" Color="#3A0E18"/>  <!-- dark text inside a filled coral circle -->

    <!-- ===== chips, toggles, search ===== -->
    <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#20243A"/>
    <SolidColorBrush x:Key="AppChipTextBrush" Color="#B7BCD4"/>
    <SolidColorBrush x:Key="AppToggleTrackBrush" Color="#20243A"/>
    <SolidColorBrush x:Key="AppSearchBackgroundBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="AppSearchBorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="AppIconTileBrush" Color="#FFFFFFFF"/>

    <!-- ===== SPEC-GLASS G2: glass card resources (same key set in all four themes) ===== -->
    <!-- Fill: 14% white fading to 6% (dark glass, over the cyan-glow backdrop) -->
    <LinearGradientBrush x:Key="GlassFillGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Specular edge: 40% white at top-left fading to 5% at bottom-right -->
    <LinearGradientBrush x:Key="GlassEdgeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassTopHighlightBrush" Color="#40FFFFFF"/>
    <!-- G3: segmented-control track + "liquid" thumb (aurora) -->
    <SolidColorBrush x:Key="GlassSegTrackBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="GlassSegThumbBrush" Color="#66FFFFFF"/>
    <!-- G3: tinted glass buttons (primary / Allow-mint / Block-coral) + their icon+text colours -->
    <LinearGradientBrush x:Key="GlassPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#593B82F6" Offset="0"/>
        <GradientStop Color="#333B82F6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassMintBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4034D399" Offset="0"/>
        <GradientStop Color="#2634D399" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCoralBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FB7185" Offset="0"/>
        <GradientStop Color="#26FB7185" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassMintTextBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="GlassCoralTextBrush" Color="#FB7185"/>
    <!-- Cached blurred aurora snapshot: ImageSource is set once at startup (see
         MainWindow.CaptureGlassBackdrop). This is the theme where the blur shows. -->
    <ImageBrush x:Key="GlassAuroraBackdropBrush" Opacity="0.55" Stretch="Fill"/>
    <!-- Card-only shadow (rows/pills get none) -->
    <DropShadowEffect x:Key="GlassCardShadow" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.3" Color="#000000"/>
</ResourceDictionary>
