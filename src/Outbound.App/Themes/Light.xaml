<!--
  Light theme. Stock WPF-UI keys come from WPF-UI's Light theme; this supplies the app's own
  keys. Same key set as Graphite.xaml / Midnight.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppWindowBorderBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E1E4E8"/>
    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="AppTitleBarBackgroundBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="AppRowHoverBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="AppRowSelectedBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="AppRowDividerBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#F1F3F7"/>
    <SolidColorBrush x:Key="AppChipTextBrush" Color="#5A6472"/>
    <SolidColorBrush x:Key="AppToggleTrackBrush" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="AppGreenBrush" Color="#1FA34A"/>
    <SolidColorBrush x:Key="AppRedBrush" Color="#D93036"/>
    <SolidColorBrush x:Key="AppOrangeBrush" Color="#E08700"/>
    <SolidColorBrush x:Key="AppBlueBrush" Color="#1D6FE0"/>
    <SolidColorBrush x:Key="AppSearchBackgroundBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="AppSearchBorderBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="AppIconTileBrush" Color="#FFFFFFFF"/>

    <!-- ===== semantic keys (same key set as Aurora) ===== -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#1D6FE0"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#3A85E8"/>
    <SolidColorBrush x:Key="AppAllowedBrush" Color="#1FA34A"/>
    <SolidColorBrush x:Key="AppBlockedBrush" Color="#D93036"/>
    <SolidColorBrush x:Key="AppAskingBrush" Color="#E08700"/>
    <SolidColorBrush x:Key="AppReceivedBrush" Color="#0E7FA8"/>
    <SolidColorBrush x:Key="AppSentBrush" Color="#C2590B"/>
    <SolidColorBrush x:Key="AppAIBrush" Color="#7A3FD0"/>
    <SolidColorBrush x:Key="AppAllowedTintBrush" Color="#261FA34A"/>
    <SolidColorBrush x:Key="AppBlockedTintBrush" Color="#26D93036"/>
    <SolidColorBrush x:Key="AppAskingTintBrush" Color="#26E08700"/>
    <SolidColorBrush x:Key="AppAccentTintBrush" Color="#261D6FE0"/>
    <SolidColorBrush x:Key="GlassSheenBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="GlassEdgeInnerBrush" Color="#33FFFFFF"/>
    <!-- G3: segmented-control track + "liquid" thumb (light) -->
    <SolidColorBrush x:Key="GlassSegTrackBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="GlassSegThumbBrush" Color="#F2FFFFFF"/>
    <!-- G3: tinted glass buttons (primary / Allow-mint / Block-coral) + their icon+text colours -->
    <LinearGradientBrush x:Key="GlassPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#590067C0" Offset="0"/>
        <GradientStop Color="#2E0067C0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassMintBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3315803D" Offset="0"/>
        <GradientStop Color="#1F15803D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCoralBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33DC2626" Offset="0"/>
        <GradientStop Color="#1FDC2626" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassMintTextBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="GlassCoralTextBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="AppOnAllowedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppOnBlockedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppSidebarSelectedBrush" Color="#1A1D6FE0"/>
    <Color x:Key="AppGlowVioletColor">#00000000</Color>
    <Color x:Key="AppGlowVioletMidColor">#00000000</Color>
    <Color x:Key="AppGlowTealMidColor">#00000000</Color>
    <Color x:Key="AppGlowTealColor">#00000000</Color>

    <!-- ===== SPEC-GLASS G2: glass card resources (same key set in all four themes) ===== -->
    <!-- Fill: 70% white fading to 55% (light glass) -->
    <LinearGradientBrush x:Key="GlassFillGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3FFFFFF" Offset="0"/>
        <GradientStop Color="#8CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Specular edge: 40% white at top-left fading to 5% at bottom-right -->
    <LinearGradientBrush x:Key="GlassEdgeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassTopHighlightBrush" Color="#40FFFFFF"/>
    <!-- Cached blurred aurora snapshot: ImageSource is set once at startup (see
         MainWindow.CaptureGlassBackdrop). Empty in non-Aurora themes because the
         glow colours there are transparent. -->
    <ImageBrush x:Key="GlassAuroraBackdropBrush" Opacity="0.35" Stretch="Fill"/>
    <!-- Card-only shadow (rows/pills get none) -->
    <DropShadowEffect x:Key="GlassCardShadow" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#3A4A66"/>
</ResourceDictionary>
