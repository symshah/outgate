<!--
  Typography — bundled fonts (SIL OFL 1.1, see Fonts/OFL.txt) and the app type scale.
  Merged LAST in App.xaml so ContentControlThemeFontFamily overrides WPF-UI's own key and every
  WPF-UI control inherits Plus Jakarta Sans.
  Note: the static TTFs carry weight-suffixed family names (Medium/SemiBold are separate families),
  so each weight has its own FontFamily resource instead of relying on FontWeight.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== families (Build Action = Resource → pack URI) ===== -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="UiFontMedium">pack://application:,,,/Fonts/#Plus Jakarta Sans Medium</FontFamily>
    <FontFamily x:Key="UiFontSemiBold">pack://application:,,,/Fonts/#Plus Jakarta Sans SemiBold</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="MonoFontMedium">pack://application:,,,/Fonts/#JetBrains Mono Medium</FontFamily>

    <!-- every WPF-UI control picks its typeface from this key -->
    <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="MessageFontFamily">pack://application:,,,/Fonts/#Plus Jakarta Sans</FontFamily>

    <!-- ===== type scale =====
         page title 30 Bold · section title 17 SemiBold · row title 14 SemiBold ·
         body 13 Regular · labels/captions 11.5 Regular · stat numbers 22 Mono Medium -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemiBold}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontSemiBold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
    <!-- numbers, IPs, ports, byte counts, times -->
    <Style x:Key="StatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- app-wide default for plain text -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
</ResourceDictionary>
