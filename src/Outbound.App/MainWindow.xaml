<ui:FluentWindow x:Class="Outbound.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:lucide="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OutGate — outbound firewall monitor" Height="780" Width="1240"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <!-- Theme-aware card + text styles. The Card uses the app's own palette keys so every
             theme (incl. Midnight) fully controls its fill/border. -->
        <!-- SPEC-GLASS G2: the local Card style is now the global glass card
             (fill gradient, cached blurred aurora, specular edge, top highlight,
             card-only shadow, radius 18). All existing usages keep working. -->
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource GlassCard}"/>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <!-- stat numbers: JetBrains Mono Medium 22 (SPEC-UI type scale) -->
        <Style x:Key="BigNum" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFontMedium}"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>
        <!-- SPEC-GLASS G1: the slow aurora drift (started from code on window load). -->
        <Storyboard x:Key="AuroraDrift" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowLayer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="40" Duration="0:01:00"/>
            <DoubleAnimation Storyboard.TargetName="GlowLayer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="26" Duration="0:01:30"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Aurora's two soft glows (8% each), behind everything. The colour keys are transparent
             in the other themes, so this layer costs nothing there. -->
        <Grid x:Name="GlowLayer" IsHitTestVisible="False" Opacity="0.08" Margin="-60">
            <!-- SPEC-GLASS G1: slow drift — X loops over 60s, Y over 90s (independent
                 periods → a wandering Lissajous path), both auto-reversing. The -60 margin
                 oversizes the layer so the drift never exposes a bare edge. -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="GlowDrift"/>
            </Grid.RenderTransform>
            <!-- large radial gradients anchored to the corners: violet top-left, teal bottom-right.
                 (Full-size gradient rectangles instead of giant blurred ellipses — oversize geometry
                 makes PrintWindow return a blank frame, and screenshots are our proof.) -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0,0" Center="0,0" RadiusX="1.05" RadiusY="1.15">
                        <GradientStop Color="{DynamicResource AppGlowVioletColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource AppGlowVioletMidColor}" Offset="0.38"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="1,1" Center="1,1" RadiusX="1.05" RadiusY="1.15">
                        <GradientStop Color="{DynamicResource AppGlowTealColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource AppGlowTealMidColor}" Offset="0.38"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

    <DockPanel LastChildFill="True">
        <!-- Caption bar. FluentWindow extends content into the title bar (ExtendsContentIntoTitleBar),
             so without a ui:TitleBar the window has no minimise/maximise/close buttons and cannot be
             dragged or double-click-maximised. The control also supplies the drag region + caption
             buttons and follows the window state on its own. -->
        <ui:TitleBar x:Name="TitleBarCtl" DockPanel.Dock="Top" Title="OutGate — outbound firewall monitor"/>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
        </Border>

        <!-- Toolbar. At the default 1240-DIP window width the row needs ~1350 DIP, so without a
             horizontal scroll the right-hand controls (Dark mode / Network not working?) were
             unreachable — clipped by the window edge. -->
        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
            <!-- SPEC-GLASS G3: status pill — floating glass capsule; mode wired to real state in Render() -->
            <Border Style="{StaticResource GlassToolbarCapsule}" Margin="8,4,0,4" Padding="12,4" CornerRadius="14">
                <TextBlock x:Name="StatusPill" Text="Protected · Ask mode" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </Border>
            <!-- SPEC-GLASS G3: the toolbar controls grouped inside one floating glass capsule -->
            <Border Style="{StaticResource GlassToolbarCapsule}" Margin="8,4" Padding="4,3">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="BtnRefresh" Content="Refresh now" Margin="8,4" Padding="12,5"/>
                <TextBlock x:Name="FlowCountText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="12,0"/>
                <Separator Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,6"/>
                <CheckBox x:Name="ChkDryRun" Content="Enforcement dry-run (no firewall changes)" IsChecked="True"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="12,0"/>
                <Button x:Name="BtnApplyRules" Style="{StaticResource GlassPrimaryButton}" Margin="8,4">
                    <TextBlock Text="Apply deny-rules to Windows Firewall"/>
                </Button>
                <ui:Button x:Name="BtnClearRules" Content="Remove OutGate firewall rules" Margin="4,4" Padding="12,5"/>
                <Separator Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="8,6"/>
                <ui:Button x:Name="BtnThemeToggle" Content="Dark mode" Margin="8,4" Padding="12,5"/>
                <ui:Button x:Name="BtnCompact" Margin="4,4" Padding="12,5" ToolTip="Compact live Activity feed">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="LayoutColumnThree24" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Activity" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="BtnHelp" Content="Network not working?" Margin="4,4" Padding="12,5"/>
            </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Left navigation (SPEC Phase 3 item 4).
             A ListBox, not ui:NavigationView: WPF-UI 4.0 puts MenuItems into an internal
             ItemsControl whose ItemAutomationPeer containers expose no Invoke/SelectionItem
             pattern, so Narrator saw the menu but could not activate or select an item.
             ListBoxItem provides SelectionItem (and ListBox Selection) natively, plus the
             standard arrow-key/Enter menu keyboard behaviour. -->
        <!-- SPEC-GLASS G2: sidebar glass panel (rows, not a card — no shadow). -->
        <Border DockPanel.Dock="Left" Style="{StaticResource GlassRow}" Width="170">
        <ListBox x:Name="NavList" BorderThickness="0" Padding="0,8"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="NavList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="Margin" Value="6,2"/>
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Border>
                                    <Rectangle x:Name="ActiveBar" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                               Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSidebarSelectedBrush}"/>
                                        <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Tag="overview" AutomationProperties.Name="Overview">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Home24" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Overview" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="activity" AutomationProperties.Name="Activity">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Globe24" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Activity" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="rules" AutomationProperties.Name="Rules">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Rules" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="review" AutomationProperties.Name="Review">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="MailInbox24" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Review" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="map" AutomationProperties.Name="Map">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Map24" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Map" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="settings" AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>
        </Border>

        <!-- All pages stacked; code-behind shows the selected one -->
        <Grid Margin="8">
                <!-- ============ OVERVIEW ============ -->
                <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <!-- shown when live (byte-accurate) monitoring is not running: zeros here are
                             not "no traffic", they are "we cannot see traffic" -->
                        <Border x:Name="OvMonitoringBanner" Visibility="Collapsed" CornerRadius="12" Margin="0,0,0,10" Padding="14,12"
                                Background="{DynamicResource AppAskingTintBrush}" BorderBrush="{DynamicResource AppAskingBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="18" VerticalAlignment="Top" Margin="0,1,0,0"
                                               Foreground="{DynamicResource AppAskingBrush}"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock x:Name="OvMonitoringTitle" Style="{StaticResource RowTitle}" FontSize="14.5"
                                               Text="Live monitoring is off"/>
                                    <TextBlock x:Name="OvMonitoringDetail" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Byte counts and per-app traffic need the kernel ETW session, which requires administrator rights."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Protection" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="OvMode" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="OvEnforce" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Filter health" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="OvSource" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="OvEvents" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Apps online" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="OvAppsOnline" Style="{StaticResource BigNum}"/>
                                    <TextBlock x:Name="OvFlows" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Allowed today" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="OvAllowed" Style="{StaticResource BigNum}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Blocked today" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="OvBlocked" Style="{StaticResource BigNum}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Most active apps (by bytes)" Style="{StaticResource H2}"/>
                                <ItemsControl x:Name="OvTopApps">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Bytes}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Recently blocked hosts" Style="{StaticResource H2}"/>
                                <ItemsControl x:Name="OvBlockedHosts">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Host}" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ ACTIVITY ============ -->
                <Grid x:Name="PageActivity" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <!-- Search + smart filter tokens (SPEC Phase 3: AI apps, ad/tracking, new, unsigned, MS services, local, abroad, heavy) -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- SPEC-GLASS G3: glass search capsule with Lucide magnifier (shared style) -->
                                <Border Style="{StaticResource GlassSearchCapsule}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <lucide:PackIconLucide Grid.Column="0" Kind="Search" Width="15" Height="15"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBox Grid.Column="1" x:Name="TxtSearch" FontSize="13" BorderThickness="0"
                                                 Background="Transparent" Padding="0,6" VerticalContentAlignment="Center"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 ToolTip="Free text (app / host / IP) plus smart tokens: ai · ads · new · unsigned · microsoft · local · abroad · heavy"/>
                                    </Grid>
                                </Border>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="TokAi" Content="ai apps" Margin="0,0,10,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <CheckBox x:Name="TokAds" Content="ads / tracking" Margin="0,0,10,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <CheckBox x:Name="TokNew" Content="new apps" Margin="0,0,10,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <CheckBox x:Name="TokUnsigned" Content="unsigned" Margin="0,0,10,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <CheckBox x:Name="TokMicrosoft" Content="microsoft services" Margin="0,0,10,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <CheckBox x:Name="TokLocal" Content="local network" Margin="0,0,10,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <CheckBox x:Name="TokAbroad" Content="abroad" Margin="0,0,10,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <CheckBox x:Name="TokHeavy" Content="heavy users" Margin="0,0,10,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Time-range picker (SPEC Phase 3) -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Time range:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            <ComboBox x:Name="CmbRange" Width="150" Margin="8,0" SelectedIndex="4">
                                <ComboBoxItem Content="Last 5 minutes"/>
                                <ComboBoxItem Content="Last 30 minutes"/>
                                <ComboBoxItem Content="Last hour"/>
                                <ComboBoxItem Content="Last 6 hours"/>
                                <ComboBoxItem Content="All time (default)"/>
                            </ComboBox>
                            <TextBlock x:Name="RangeNote" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Apps grouped with their destinations (SPEC Phase 3 item 4) -->
                        <ListView x:Name="ActivityList" BorderThickness="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Margin="0,3">
                                        <StackPanel>
                                            <!-- App row: icon · name · N destinations · signer · sparkline · counts · last seen -->
                                            <Grid Margin="12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Subline}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Image Grid.Column="2" Source="{Binding SparkImage}" Width="138" Height="40" VerticalAlignment="Center" Margin="8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Counts}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding BytesDisplay}" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="{Binding LastSeen}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- Expanded destination rows -->
                                            <ItemsControl ItemsSource="{Binding Dests}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="46,5,12,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                                    <Run Text="{Binding HostPrefix, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    <Run Text="{Binding HostDomain, Mode=OneWay}" FontWeight="Bold"/>
                                                                    <Run Text="{Binding Rest, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding Geo}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding BytesDisplay}" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Right"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding LastSeen}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>

                    <!-- Inspector: why was this connection allowed/blocked -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Inspector — why this decision" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="InspTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InspBody" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ RULES ============ -->
                <Grid x:Name="PageRules" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Add rule:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbAction" Width="90" Margin="8,0">
                                <ComboBoxItem Content="Deny" IsSelected="True"/>
                                <ComboBoxItem Content="Allow"/>
                            </ComboBox>
                            <TextBox x:Name="TxtApp" Width="160" Margin="8,0" VerticalContentAlignment="Center" ToolTip="Process name or full exe path (empty = any app)"/>
                            <TextBlock Text="→" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtDest" Width="200" Margin="8,0" VerticalContentAlignment="Center" ToolTip="Domain, IP, CIDR, or 'any'"/>
                            <TextBlock Text="port" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPort" Width="70" Margin="6,0" VerticalContentAlignment="Center" Text="any"/>
                            <ComboBox x:Name="CmbLifetime" Width="120" Margin="8,0">
                                <ComboBoxItem Content="Forever" IsSelected="True"/>
                                <ComboBoxItem Content="1 hour"/>
                                <ComboBoxItem Content="Until app quits"/>
                                <ComboBoxItem Content="Once (next match)"/>
                            </ComboBox>
                            <ui:Button x:Name="BtnAddRule" Content="Add rule" Padding="14,5"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8"
                              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" RowBackground="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                              AlternatingRowBackground="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="70"/>
                            <DataGridTextColumn Header="App" Binding="{Binding AppMatcherDisplay}" Width="180"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="220"/>
                            <DataGridTextColumn Header="Port" Binding="{Binding PortSpec}" Width="70"/>
                            <DataGridTextColumn Header="Lifetime" Binding="{Binding LifetimeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70"/>
                            <DataGridTextColumn Header="Profile" Binding="{Binding ProfileDisplay}" Width="80"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <ui:Button x:Name="BtnDeleteRule" Content="Delete selected rule" Padding="14,5"/>
                        <TextBlock x:Name="RulesHint" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- ============ REVIEW ============ -->
                <Grid x:Name="PageReview" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,4">
                        <ui:Button DockPanel.Dock="Right" x:Name="BtnAllowVerified" Content="Allow verified publishers" Padding="12,5"/>
                        <TextBlock Text="Things decided without asking — newest first. Allow/block turns an item into a rule; dismiss just hides it." Style="{StaticResource H2}"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="ReviewGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" RowBackground="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                              AlternatingRowBackground="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="App" Binding="{Binding AppName}" Width="150"/>
                            <DataGridTextColumn Header="Host / IP" Binding="{Binding HostOrIp}" Width="170"/>
                            <DataGridTextColumn Header="Port · Proto" Binding="{Binding PortProto}" Width="90"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="260"/>
                            <DataGridTextColumn Header="When" Binding="{Binding WhenDisplay}" Width="130"/>
                            <DataGridTemplateColumn Header="" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="Allow" Padding="8,2" Margin="0,0,4,0" Tag="{Binding Id}" Click="ReviewAllow_Click"/>
                                            <ui:Button Content="Block" Appearance="Danger" Padding="8,2" Margin="0,0,4,0" Tag="{Binding Id}" Click="ReviewBlock_Click"/>
                                            <ui:Button Content="Dismiss" Appearance="Secondary" Padding="8,2" Tag="{Binding Id}" Click="ReviewDismiss_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============ MAP (Phase 4): offline WebView2 map/globe ============ -->
                <Grid x:Name="PageMap" Visibility="Collapsed">
                    <wv2:WebView2 x:Name="MapWeb"/>
                    <StackPanel x:Name="MapFallback" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Map unavailable — WebView2 runtime not found" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Install the Microsoft Edge WebView2 Runtime (preinstalled on Windows 10/11) and restart OutGate."/>
                    </StackPanel>
                </Grid>

                <!-- ============ SETTINGS ============ -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Mode" Style="{StaticResource H2}"/>
                                <ComboBox x:Name="CmbMode" Width="160" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Learn (allow + review)"/>
                                    <ComboBoxItem Content="Ask (prompt on new connections)"/>
                                    <ComboBoxItem Content="Strict (deny until allowed)"/>
                                </ComboBox>
                                <TextBlock Text="Prompt timeout — TCP seconds (15–120)" Style="{StaticResource H2}"/>
                                <TextBox x:Name="TxtTcpTimeout" Width="80" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Prompt timeout — UDP seconds" Style="{StaticResource H2}"/>
                                <TextBox x:Name="TxtUdpTimeout" Width="80" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                                <CheckBox x:Name="ChkBlockUnanswered" Content="Block when a prompt is left unanswered (default: allow)" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <CheckBox x:Name="ChkBlockNewApps" Content="Block new apps until answered (Ask mode)" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:Button x:Name="BtnApplySettings" Content="Apply settings" Padding="14,5" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ APPEARANCE (themes) ============ -->
                        <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,4,2,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource H2}"/>
                                <ComboBox x:Name="CmbTheme" Width="240" HorizontalAlignment="Left" SelectionChanged="CmbTheme_SelectionChanged">
                                    <ComboBoxItem Content="Aurora (default)" Tag="Aurora"/>
                                    <ComboBoxItem Content="System (follow Windows)" Tag="System"/>
                                    <ComboBoxItem Content="Light" Tag="Light"/>
                                    <ComboBoxItem Content="Dark (graphite)" Tag="Dark"/>
                                    <ComboBoxItem Content="Midnight" Tag="Midnight"/>
                                </ComboBox>
                                <TextBlock x:Name="TxtThemeHint" Style="{StaticResource H2}" TextWrapping="Wrap"
                                           Text="Switches live — no restart. Midnight uses a navy glass palette; the map and globe follow it."/>
                            </StackPanel>
                        </Border>

                        <!-- ============ LOCATION (map origin) ============ -->
                        <TextBlock Text="Location" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,16,2,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Where this PC is" Style="{StaticResource H2}"/>
                                <ComboBox x:Name="CmbOriginCity" Width="330" HorizontalAlignment="Left"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          SelectionChanged="CmbOriginCity_SelectionChanged"/>
                                <TextBlock x:Name="TxtOriginHint" Style="{StaticResource H2}" TextWrapping="Wrap"
                                           Text="The map centres on this city and draws its arcs from it. Offline city list (Natural Earth)."/>
                            </StackPanel>
                        </Border>

                        <!-- ============ ABOUT / CREDITS ============ -->
                        <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,16,2,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="OutGate — outbound firewall monitor" Style="{StaticResource RowTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Fonts: Plus Jakarta Sans (UI text) and JetBrains Mono (numbers, IPs, ports, times), both SIL Open Font License 1.1 — Fonts/OFL.txt. Map imagery: NASA Blue Marble (topography and bathymetry) and Natural Earth II shaded relief, public domain. City list: Natural Earth populated places, public domain. Map rendering: Leaflet (BSD-2). GeoIP: DB-IP Lite City (CC BY 4.0)."/>
                            </StackPanel>
                        </Border>

                        <!-- ============ PROFILES (per network) ============ -->
                        <TextBlock Text="Profiles — per network" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,16,2,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="TxtCurrentNetwork" Text="current network: —" Style="{StaticResource H2}"/>
                                <ItemsControl x:Name="LstProfiles"/>
                                <Separator Margin="0,8"/>
                                <TextBlock Text="New profile:" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtProfileName" Width="140" VerticalContentAlignment="Center"/>
                                    <ComboBox x:Name="CmbProfileMode" Width="130" Margin="8,0,0,0">
                                        <ComboBoxItem Content="Learn (allow + review)" IsSelected="True"/>
                                        <ComboBoxItem Content="Ask (prompt on new connections)"/>
                                        <ComboBoxItem Content="Strict (deny until allowed)"/>
                                    </ComboBox>
                                    <ui:Button x:Name="BtnAddProfile" Content="Add profile" Padding="12,4" Margin="8,0,0,0" Click="BtnAddProfile_Click"/>
                                </StackPanel>
                                <TextBlock Text="Active profile:" Style="{StaticResource H2}"/>
                                <ComboBox x:Name="CmbActiveProfile" Width="220" HorizontalAlignment="Left" SelectionChanged="CmbActiveProfile_SelectionChanged"/>
                                <ui:Button x:Name="BtnMapNetwork" Content="Map current network → active profile (auto-switch on join)" Padding="14,5" HorizontalAlignment="Left" Margin="0,10,0,0" Click="BtnMapNetwork_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ BLOCKLISTS (over HTTPS) ============ -->
                        <TextBlock Text="Blocklists — over HTTPS" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,16,2,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="TxtBlocklistTotal" Text="loaded entries: 0" Style="{StaticResource H2}"/>
                                <ItemsControl x:Name="LstBlocklists"/>
                                <Separator Margin="0,8"/>
                                <TextBlock Text="New blocklist (hosts format or plain domain list):" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtBlocklistName" Width="140" VerticalContentAlignment="Center"/>
                                    <TextBox x:Name="TxtBlocklistUrl" Width="320" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                                    <ui:Button x:Name="BtnAddBlocklist" Content="Add + fetch" Padding="12,4" Margin="8,0,0,0" Click="BtnAddBlocklist_Click"/>
                                </StackPanel>
                                <ui:Button x:Name="BtnRefreshBlocklists" Content="Fetch all now" Padding="14,5" HorizontalAlignment="Left" Margin="0,10,0,0" Click="BtnRefreshBlocklists_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ============ DATA LIMITS (per app, daily) ============ -->
                        <TextBlock Text="Data limits — per app, daily" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,16,2,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="TxtLimitTotal" Text="0 limits" Style="{StaticResource H2}"/>
                                <ItemsControl x:Name="LstLimits"/>
                                <Separator Margin="0,8"/>
                                <TextBlock Text="New limit (exe path or app name) + bytes per day:" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtLimitApp" Width="260" VerticalContentAlignment="Center"/>
                                    <TextBox x:Name="TxtLimitBytes" Width="110" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                                    <ui:Button x:Name="BtnAddLimit" Content="Add limit" Padding="12,4" Margin="8,0,0,0" Click="BtnAddLimit_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,16,2,4"/>
                        <Border Style="{StaticResource Card}">
                            <ui:Button x:Name="BtnThemeToggle2" Content="Dark mode" Padding="14,5" HorizontalAlignment="Left"/>
                        </Border>

                        <TextBlock Text="Coming in Phase 5" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="2,16,2,4"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Intelligence (MCP) · Privacy · Labs — landing with the CLI/MCP/IPC phase." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
        </Grid>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
