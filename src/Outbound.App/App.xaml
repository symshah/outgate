<Application x:Class="Outbound.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- merged last: overrides ContentControlThemeFontFamily so every WPF-UI control
                     uses the bundled Plus Jakarta Sans (see Themes/Typography.xaml) -->
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <!-- SPEC-GLASS G2: glass card system (GlassCard / GlassRow / GlassPill) -->
                <ResourceDictionary Source="Themes/Glass.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
