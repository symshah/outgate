<Window x:Class="Outbound.App.AskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:lucide="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="OutGate — connection request" Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- Segmented radio-button style: the checked choice is visibly highlighted -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- SPEC-GLASS G2: glass capsule (radius 14) -->
                        <Border x:Name="bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource GlassFillGradient}"
                                BorderBrush="{DynamicResource GlassEdgeGradient}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="190"/>
        </Grid.ColumnDefinitions>

        <!-- Main question -->
        <StackPanel Grid.Column="0">
            <!-- SPEC-GLASS G2: glass cards -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Margin="0,0,12,0"
                            Background="{DynamicResource GlassFillGradient}"
                            BorderBrush="{DynamicResource GlassEdgeGradient}" BorderThickness="1">
                        <Image x:Name="AppIcon" Stretch="Uniform" Margin="6"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AppName" Text="—" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SignerLine" Text="" Margin="0,3,0,0" FontSize="12.5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Wants to connect to" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="DestLine" Margin="0,4,0,2" FontSize="15" TextWrapping="Wrap">
                        <Run x:Name="DestSub" Text=""/><Run x:Name="DestMain" FontWeight="Bold" Text=""/>
                    </TextBlock>
                    <TextBlock x:Name="PortLine" Text="" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="PublisherNote" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Lifetime (segmented) -->
            <TextBlock Text="Remember for" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,0,0,5"/>
            <UniformGrid x:Name="LifetimeRow" Rows="1" Columns="4">
                <RadioButton x:Name="LifeOnce" GroupName="lifetime" Content="Once" Style="{StaticResource Seg}" Checked="Life_Checked" Tag="Once"/>
                <RadioButton x:Name="LifeHour" GroupName="lifetime" Content="1 Hour" Style="{StaticResource Seg}" Checked="Life_Checked" Tag="Hours"/>
                <RadioButton x:Name="LifeQuit" GroupName="lifetime" Content="Until Quit" Style="{StaticResource Seg}" Checked="Life_Checked" Tag="UntilQuit"/>
                <RadioButton x:Name="LifeForever" GroupName="lifetime" Content="Forever" IsChecked="True" Style="{StaticResource Seg}" Checked="Life_Checked" Tag="Forever"/>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="More:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <RadioButton x:Name="LifeLogout" GroupName="lifetime" Content="Until Logout" Style="{StaticResource Seg}" Checked="Life_Checked" Tag="UntilLogout"/>
                <RadioButton x:Name="LifeRestart" GroupName="lifetime" Content="Until Restart" Style="{StaticResource Seg}" Checked="Life_Checked" Tag="UntilRestart"/>
            </StackPanel>

            <!-- Scope (segmented) -->
            <TextBlock Text="Scope" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2,10,0,5"/>
            <UniformGrid Rows="1" Columns="3">
                <RadioButton x:Name="ScopePort" GroupName="scope" Content="This port only" IsChecked="True" Style="{StaticResource Seg}" Checked="Scope_Checked" Tag="port"/>
                <RadioButton x:Name="ScopeAny" GroupName="scope" Content="Any port" Style="{StaticResource Seg}" Checked="Scope_Checked" Tag="any"/>
                <RadioButton x:Name="ScopeAnyAny" GroupName="scope" Content="Any port &amp; protocol" Style="{StaticResource Seg}" Checked="Scope_Checked" Tag="any-any"/>
            </UniformGrid>

            <!-- Countdown + actions -->
            <TextBlock x:Name="CountdownLine" Margin="2,14,0,8" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnDeny" Grid.Column="0" Style="{StaticResource GlassCoralButton}" IsEnabled="False"
                        IsDefault="False" IsCancel="False" Click="Deny_Click">
                    <StackPanel Orientation="Horizontal">
                        <lucide:PackIconLucide Kind="Ban" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource GlassCoralTextBrush}"/>
                        <TextBlock Text="Deny"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAllow" Grid.Column="2" Style="{StaticResource GlassMintButton}" IsEnabled="False"
                        IsDefault="False" IsCancel="False" Click="Allow_Click">
                    <StackPanel Orientation="Horizontal">
                        <lucide:PackIconLucide Kind="Check" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource GlassMintTextBrush}"/>
                        <TextBlock Text="Allow"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Side queue -->
        <StackPanel Grid.Column="2">
            <TextBlock x:Name="QueueTitle" Text="Waiting (0)" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <ItemsControl x:Name="QueueList" MaxHeight="220">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12.5" Margin="0,3" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="BtnAnswerAll" Style="{StaticResource GlassPrimaryButton}" Click="AnswerAll_Click"
                    Margin="0,10,0,0" IsEnabled="False">
                <TextBlock Text="Answer all for this app"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
